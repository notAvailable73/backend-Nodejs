{
  "name": "jamiya-backend",
  "version": "1.0.0",
  "description": "A backend project for Jamia as suffah",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon ./src/server.js",
    "start": "node ./src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "report": "npm run report:capture && npm run report:build",
    "report:capture": "node report/capture.mjs",
    "report:build": "node report/build.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suffahUniversity/backend-Nodejs.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/suffahUniversity/backend-Nodejs/issues"
  },
  "homepage": "https://github.com/suffahUniversity/backend-Nodejs#readme",
  "dependencies": {
    "bcryptjs": "^3.0.0",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.4",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "espree": "11.2.0",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "jscpd": "5.4.2",
    "nodemon": "^3.1.9",
    "supertest": "7.3.1"
  }
}
