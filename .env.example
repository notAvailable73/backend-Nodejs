PORT=5000
NODE_ENV=development

# Local MongoDB from docker-compose.yml (`npm run db:up`)
MONGODB_URI=mongodb://127.0.0.1:27017/jamiya
# Used by the Jest suite; must be a separate database, it is wiped between tests
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/jamiya_test

# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE=7d

# Only needed for file uploads (src/utils/cloudinary.js)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
